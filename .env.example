# ─────────────────────────────────────────────
#  PlaySong — Environment Variables
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# ── Server ─────────────────────────────────
PORT=3001
NODE_ENV=development

# ── YouTube Data API v3 ────────────────────
# Get yours at: https://console.cloud.google.com
# Enable "YouTube Data API v3" in the API Library
YOUTUBE_API_KEY=your_youtube_api_key_here

# ── Spotify Web API ────────────────────────
# Get yours at: https://developer.spotify.com/dashboard
# Used for BPM / audio features metadata only (no playback)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# ── Vercel (production) ────────────────────
# Set these in your Vercel project's environment variable settings
# VERCEL_URL is auto-set by Vercel — no need to set manually
